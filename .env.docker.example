# =============================================================================
# GESTAOSUAS-DJANGO — Variáveis para Docker Compose (Produção / VPS)
# Copie para .env.docker e use com: docker compose --env-file .env.docker up -d
# NUNCA commitar este arquivo com valores reais preenchidos.
# =============================================================================


# ─── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=troque-por-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=servidor-qualificacao.tailbeb7d5.ts.net,100.76.30.36,localhost
CSRF_TRUSTED_ORIGINS=https://servidor-qualificacao.tailbeb7d5.ts.net:8443


# ─── Banco de Dados ──────────────────────────────────────────────────────────
# Em produção o app fala com o serviço "db" do docker-compose.yml
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=troque-por-senha-segura
DB_HOST=db
DB_PORT=5432


# ─── Supabase Storage (opcional — só upload de documentos de visita) ─────────
# Não é mais usado para autenticação nem para o banco (isso já é Postgres
# puro). Só é lido em apps/directorates/views.py para enviar/remover anexos
# de visita (bucket "system-assets"). Se vazio, o upload cai automaticamente
# para armazenamento local em disco (ver _save_file_locally).
SUPABASE_URL=
SUPABASE_ANON_KEY=
